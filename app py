from flask import Flask
from telegram import InlineKeyboardButton, InlineKeyboardMarkup, Update
from telegram.ext import Updater, CommandHandler, CallbackQueryHandler
import subprocess, os

app = Flask(__name__)

TOKEN = os.environ.get("TOKEN")
CHAT_ID = os.environ.get("CHAT_ID")

updater = Updater(TOKEN, use_context=True)
dispatcher = updater.dispatcher

def start(update, context):
    keyboard = [
        [InlineKeyboardButton("🔦 ON", callback_data='on')],
        [InlineKeyboardButton("💡 OFF", callback_data='off')]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    update.message.reply_text("Choose flashlight action:", reply_markup=reply_markup)

def button(update: Update, context):
    query = update.callback_query
    query.answer()
    if query.data == 'on':
        subprocess.run(["adb", "shell", "cmd", "torch", "on"])
        query.edit_message_text(text="Flashlight turned ON 🔦")
    elif query.data == 'off':
        subprocess.run(["adb", "shell", "cmd", "torch", "off"])
        query.edit_message_text(text="Flashlight turned OFF 💡")

dispatcher.add_handler(CommandHandler("start", start))
dispatcher.add_handler(CallbackQueryHandler(button))

@app.route('/trigger', methods=['GET'])
def trigger():
    keyboard = [
        [InlineKeyboardButton("🔦 ON", callback_data='on')],
        [InlineKeyboardButton("💡 OFF", callback_data='off')]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    updater.bot.send_message(chat_id=CHAT_ID, text="Flashlight control:", reply_markup=reply_markup)
    return "Bot message sent!"

if __name__ == "__main__":
    updater.start_polling()
    app.run(port=5000)
